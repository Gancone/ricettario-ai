# Required server configuration; never prefix service keys with NEXT_PUBLIC_.
APP_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Administrative session-pooler URL, used only to run the additive migrations.
# Replace [YOUR-PASSWORD] locally; URL-encode special characters in the password.
DATABASE_URL=
# Optional: only needed for extraction that cannot be parsed deterministically.
OPENAI_API_KEY=
# Optional ZIP updater: repository-scoped token, preview branches only.
GITHUB_UPDATE_TOKEN=
GITHUB_OWNER=Gancone
GITHUB_REPO=ricettario-ai
# Optional overrides. Defaults pin the verified official 2026.08.19 release.
# When changing the version supply BOTH Linux and Windows digests for that release.
# YTDLP_VERSION=2026.08.19
# YTDLP_SHA256=58162f9bfdc27458ea47bfcb311cf47028f17d8154a8bf7d689861d46399230a
# YTDLP_WINDOWS_SHA256=66674953fe251b89f4d08c5f0e35e0728679bd67ab3d7d05c0562af101dd3e7a
